{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "checksum",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      }
    },
    "bundle": {
      "active": true,
      "targets": [
        "msi",
        "nsis",
        "app",
        "dmg",
        "deb",
        "rpm",
        "appimage"
      ],
      "identifier": "com.checksum.app",
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper",
          "silent": true
        }
      },
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "checksum",
        "width": 800,
        "height": 600,
        "minWidth": 520,
        "minHeight": 450
      }
    ]
  }
}
